# Copy to ~/.config/modern/battlenet.env (gitignored) after Steam install.
# Prefer STEAM_APPID. Use BATTLENET_EXE only for a direct umu-run path.

# Non-Steam Battle.net shortcut id from Steam (Properties → shortcuts / rungameid).
STEAM_APPID=

# Absolute path to Battle.net Launcher.exe inside the Proton prefix, e.g.
# $HOME/.local/share/Steam/steamapps/compatdata/<id>/pfx/drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe
# BATTLENET_EXE=
# WINEPREFIX=
# PROTONPATH=GE-Proton

# Already defaulted by scripts/battlenet — override only if needed:
# PROTON_ENABLE_WAYLAND=0
# WINE_SIMULATE_WRITECOPY=1
# AMD_VULKAN_ICD=RADV
