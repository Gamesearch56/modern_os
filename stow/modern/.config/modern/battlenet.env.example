# Copy to ~/.config/modern/battlenet.env (gitignored) after Steam install.
# Prefer BATTLENET_EXE — Steam Non-Steam AppID launch is unreliable on Linux.
# Quote paths that contain spaces.

# Absolute path to Battle.net Launcher.exe inside the Proton prefix:
BATTLENET_EXE="$HOME/.local/share/Steam/steamapps/compatdata/<id>/pfx/drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe"
WINEPREFIX="$HOME/.local/share/Steam/steamapps/compatdata/<id>/pfx"

# Directory containing the `proton` binary, or leave unset to auto-pick
# Proton Experimental / Hotfix / GE from the Steam tree.
# Prefer Experimental for the Battle.net CEF UI — GE-Proton 11.x has been
# aborting on win32u.NtGdiDdDDIQueryFSEBlock / user32 init. WC3 launched
# from Battle.net uses this same PROTONPATH; for the GE11-7 crypt32 fix,
# transplant those DLLs into Experimental (see docs/GAMING.md), or point
# PROTONPATH at GE-Proton11-7 only when the launcher works on it.
# PROTONPATH="$HOME/.local/share/Steam/steamapps/common/Proton - Experimental"

# Optional fallback only (often fails with "game configuration is not available"):
# STEAM_APPID=

# Already defaulted by scripts/battlenet — override only if needed:
# PROTON_ENABLE_WAYLAND=0
# WINE_SIMULATE_WRITECOPY=1
# AMD_VULKAN_ICD=RADV
# BATTLENET_IN_PROCESS_GPU=1
# BATTLENET_ARGS=--disable-gpu
# BATTLENET_HDR=1
