# Stow config for the current external image viewer only.
# install/manifests/default-apps.json imageViewer.stow names this package.
# Delete this tree with that entry.
[binds]
# Mausrad
WheelUp = zoom 0.1
WheelDown = zoom -0.1

# Pfeiltasten
Up = zoom 0.1
Down = zoom -0.1

# Rotate the currently open image by 90 degrees
<Shift+R> = exec mogrify -rotate 90 "$imv_current_file"
