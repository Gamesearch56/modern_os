[Desktop Entry]
Type=Application
Version=1.5
Name=Steam
Name[de]=Steam
Comment=Store and library
Comment[de]=Shop und Bibliothek
Exec=modern steam %U
TryExec=modern
Icon=steam
Terminal=false
StartupNotify=true
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
StartupWMClass=steam
Actions=Store;Library;

[Desktop Action Store]
Name=Store
Name[de]=Shop
Exec=modern steam steam://store

[Desktop Action Library]
Name=Library
Name[de]=Bibliothek
Exec=modern steam steam://open/library
