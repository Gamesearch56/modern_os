[Desktop Entry]
Type=Application
Name=ModernOS Imageviewer
Name[de]=ModernOS Imageviewer
GenericName=Image viewer
GenericName[de]=Bildbetrachter
Comment=View pictures and step through a folder of photos
Comment[de]=Bilder ansehen und durch einen Ordner voller Fotos blättern
Keywords=image;picture;photo;viewer;gallery;Bild;Foto;Betrachter;Galerie;
Keywords[de]=image;picture;photo;viewer;gallery;Bild;Foto;Betrachter;Galerie;
Exec=modern-imageviewer %F
Icon=modern-imageviewer
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/bmp;image/gif;image/jpeg;image/png;image/svg+xml;image/svg+xml-compressed;image/tiff;image/vnd.microsoft.icon;image/vnd.wap.wbmp;image/webp;image/x-icns;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;image/x-xbitmap;image/x-xpixmap;
StartupNotify=false
StartupWMClass=modern.imageviewer
Actions=new-window;

[Desktop Action new-window]
Name=New window
Name[de]=Neues Fenster
Exec=modern-imageviewer
