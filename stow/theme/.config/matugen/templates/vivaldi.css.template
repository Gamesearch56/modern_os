/* GENERATED by scripts/theme-apply.sh (matugen) — do not hand-edit.
   Fonts, radii and optional wallpaper path are appended in 01-chrome.css. */

:root {
    --md-primary: {{colors.primary.default.hex}};
    --md-on-primary: {{colors.on_primary.default.hex}};
    --md-primary-container: {{colors.primary_container.default.hex}};
    --md-on-primary-container: {{colors.on_primary_container.default.hex}};
    --md-surface: {{colors.surface.default.hex}};
    --md-on-surface: {{colors.on_surface.default.hex}};
    --md-surface-container: {{colors.surface_container.default.hex}};
    --md-outline-variant: {{colors.outline_variant.default.hex}};
    --md-scrim: {{colors.scrim.default.hex}};
}

::-webkit-scrollbar-thumb {
    background-color: {{colors.outline.default.hex}} !important;
    border-radius: var(--md-radius-full, 9999px) !important;
}

#browser,
#header,
.toolbar-mainbar,
.toolbar,
.tabbar,
.bookmark-bar,
.newtab-page,
#vivaldi-start-page {
    background-color: var(--md-surface) !important;
    color: var(--md-on-surface) !important;
}

.tab,
.tab-position {
    background-color: {{colors.surface_container.default.hex}} !important;
    color: var(--md-on-surface) !important;
}

.tab:hover,
.tab-position:hover {
    background-color: color-mix(in srgb, var(--md-primary) 8%, {{colors.surface_container.default.hex}}) !important;
}

.tab.active,
.tab-position.active {
    background-color: var(--md-primary) !important;
    color: var(--md-on-primary) !important;
    border-radius: var(--md-radius-full, 9999px) !important;
}

.UrlBar-AddressField,
.addressfield {
    background-color: {{colors.surface_container_highest.default.hex}} !important;
    border-radius: var(--md-radius-full, 9999px) !important;
    padding: var(--md-space-sm, 8px) var(--md-space-md, 12px) !important;
}

.UrlBar-AddressField:focus-within {
    outline: 2px solid var(--md-primary) !important;
}

.panel {
    background-color: {{colors.surface_container.default.hex}} !important;
}

.button-toolbar,
.toolbar-mainbar button {
    width: 24px;
    height: 24px;
}

.startpage .speeddial,
.startpage .widget {
    background-color: color-mix(in srgb, var(--md-surface-container) var(--md-transparency, 85%), transparent) !important;
    border-radius: var(--md-radius-md, 16px) !important;
    margin: var(--md-space-md, 12px) !important;
}

.webpageview {
    border-radius: var(--md-radius-md, 16px);
}

dialog, .dialog, #status_bar, .panel {
    background-color: {{colors.surface_container_high.default.hex}} !important;
    color: {{colors.on_surface.default.hex}} !important;
    border-radius: var(--md-radius-md, 16px) !important;
}

button, .button-toolbar {
    color: var(--md-on-surface) !important;
}
