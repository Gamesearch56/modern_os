/* GENERATED by scripts/theme-apply.sh (matugen) — do not hand-edit.
   Fonts, radii and optional wallpaper path are appended in 01-chrome.css. */

:root {
    --md-primary: {{colors.primary.default.hex}};
    --md-on-primary: {{colors.on_primary.default.hex}};
    --md-primary-container: {{colors.primary_container.default.hex}};
    --md-on-primary-container: {{colors.on_primary_container.default.hex}};
    --md-surface: {{colors.surface.default.hex}};
    --md-on-surface: {{colors.on_surface.default.hex}};
    --md-on-surface-variant: {{colors.on_surface_variant.default.hex}};
    --md-surface-container: {{colors.surface_container.default.hex}};
    --md-surface-container-high: {{colors.surface_container_high.default.hex}};
    --md-surface-container-highest: {{colors.surface_container_highest.default.hex}};
    --md-outline: {{colors.outline.default.hex}};
    --md-outline-variant: {{colors.outline_variant.default.hex}};
    --md-scrim: {{colors.scrim.default.hex}};
}

/* Vivaldi paints pageload and toolbar hover from these, as inline
   vars on #browser. Remap so leftover Wallust/brand red cannot leak. */
#browser {
    --colorAccentBg: var(--md-primary) !important;
    --colorAccentFg: var(--md-on-primary) !important;
    --colorAccentBgDark: color-mix(in srgb, var(--md-primary) 8%, transparent) !important;
    --colorAccentBgDarker: color-mix(in srgb, var(--md-primary) 12%, transparent) !important;
    --colorAccentBgFaded: color-mix(in srgb, var(--md-primary) 8%, transparent) !important;
    --colorAccentBgFadedMore: color-mix(in srgb, var(--md-primary) 12%, transparent) !important;
    --colorAccentBgFadedMost: var(--md-primary-container) !important;
    --colorHighlightBg: var(--md-primary-container) !important;
    --colorHighlightFg: var(--md-on-primary-container) !important;
}

::-webkit-scrollbar-thumb {
    background-color: var(--md-outline) !important;
    border-radius: var(--md-radius-full, 9999px) !important;
}

/* Window chrome stays opaque surface — do not mix design.transparency here. */
#browser,
.toolbar-mainbar,
.toolbar-addressbar {
    background-color: var(--md-surface) !important;
    color: var(--md-on-surface) !important;
}

#browser .tabbar-wrapper,
#browser.tabs-top #header,
#browser.tabs-bottom #footer,
#header,
#tabs-tabbar-container,
.tabbar {
    background-color: transparent !important;
    --colorTabBar: transparent !important;
}

#browser .tab:not(.active),
#browser .tab-wrapper .tab:not(.active),
.tab-position:not(.active) {
    background-color: transparent !important;
    color: var(--md-on-surface) !important;
}

#browser .tab:not(.active):hover,
#browser .tab-wrapper:hover .tab:not(.active) {
    background-color: color-mix(in srgb, var(--md-primary) 8%, transparent) !important;
}

#browser .tab.active,
#browser .tab.active.active,
.tab-position.active .tab.active {
    background-color: var(--md-primary) !important;
    color: var(--md-on-primary) !important;
    border-radius: var(--md-radius-full, 9999px) !important;
}

#browser .mainbar {
    width: 100% !important;
    max-width: 100% !important;
}

#browser .toolbar-addressbar,
#browser .mainbar .toolbar-mainbar {
    width: 100% !important;
    max-width: 100% !important;
    flex: 1 1 auto !important;
}

#browser .mainbar .toolbar-spacer-flexible,
#browser .toolbar-addressbar .toolbar-spacer-flexible {
    flex: 0 0 0px !important;
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    overflow: hidden !important;
}

#browser .mainbar .UrlBar-AddressField,
#browser .mainbar .UrlBar-SearchField,
#browser .mainbar .SearchField,
#browser .toolbar-addressbar .UrlBar-AddressField,
#browser .toolbar-addressbar .UrlBar-SearchField,
.UrlBar-AddressField,
.addressfield {
    flex: 1 1 0% !important;
    min-width: 0 !important;
    max-width: none !important;
    width: unset !important;
    margin-inline: 0 !important;
    background-color: var(--md-surface-container-highest) !important;
    border-radius: var(--md-radius-full, 9999px) !important;
    padding: var(--md-space-sm, 8px) var(--md-space-md, 12px) !important;
}

.UrlBar-AddressField:focus-within,
.UrlBar-SearchField:focus-within {
    outline: 2px solid var(--md-primary) !important;
}

.UrlBar-AddressField .pageload .pageload-indicator {
    background-color: var(--md-primary) !important;
    border-radius: var(--md-radius-full, 9999px) !important;
    overflow: hidden !important;
}

.UrlBar-AddressField .pageload .pageload-indicator::-webkit-progress-bar {
    background: transparent !important;
    border-radius: var(--md-radius-full, 9999px) !important;
}

.UrlBar-AddressField .pageload .pageload-indicator::-webkit-progress-value {
    border-radius: var(--md-radius-full, 9999px) !important;
    background-color: var(--md-primary) !important;
}

.toolbar-tabbar .button-toolbar.newtab > button:hover,
.toolbar-tabbar .button-toolbar > button:hover {
    background-color: color-mix(in srgb, var(--md-primary) 8%, transparent) !important;
}

.toolbar-mainbar,
.toolbar-addressbar {
    --ToolbarItemGap: var(--md-space-xs, 4px) !important;
    gap: var(--md-space-xs, 4px) !important;
}

.toolbar-extensions,
.toolbar-extensions .toolbar,
.toolbar-extensions .toolbar-group,
.toolbar-mainbar .profile-popup {
    --ToolbarItemGap: var(--md-space-xs, 4px) !important;
    gap: var(--md-space-xs, 4px) !important;
}

.toolbar-extensions .button-toolbar {
    margin-inline: 0 !important;
}

.toolbar-mainbar .profile-popup {
    margin-inline-start: var(--md-space-xs, 4px) !important;
}

#browser .bookmark-bar,
.bookmark-bar {
    background-color: transparent !important;
    color: var(--md-on-surface) !important;
    border-color: transparent !important;
}

.bookmarkbarItem,
.bookmark-bar button {
    background-color: transparent !important;
    color: var(--md-on-surface) !important;
    border-radius: var(--md-radius-sm, 8px) !important;
    box-shadow: none !important;
}

.bookmarkbarItem:hover,
.bookmark-bar button:hover {
    background-color: color-mix(in srgb, var(--md-primary) 8%, transparent) !important;
}

:not(.topmenu) > .menu > ul,
.menu,
.menu ul,
.menu ul ul,
.context-menu {
    background-color: var(--md-surface-container) !important;
    color: var(--md-on-surface) !important;
    border: 1px solid var(--md-outline-variant) !important;
    border-radius: var(--md-radius-md, 16px) !important;
    box-shadow: none !important;
}

.menu li:hover,
.menu li.selectedItem,
.menu .hover,
.menu .selected {
    background-color: color-mix(in srgb, var(--md-primary) 12%, transparent) !important;
    color: var(--md-on-surface) !important;
}

#browser #panels-container,
#browser #switch,
#browser #panels-container .toolbar,
#browser #switch .toolbar,
.panel-group,
.panel {
    background-color: var(--md-surface-container) !important;
    color: var(--md-on-surface) !important;
}

#panels-container {
    border-inline-end: 1px solid var(--md-outline-variant) !important;
}

.UrlBar-AddressField .toolbar,
.UrlBar-SearchField .toolbar,
.toolbar-insideinput,
.toolbar-insideinput .button-toolbar,
.toolbar-insideinput button {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
    border-color: transparent !important;
}

.toolbar-mainbar button,
.toolbar-addressbar button,
.toolbar-extensions button {
    background: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
    border-color: transparent !important;
}

.toolbar-mainbar > .button-toolbar > button {
    width: 24px;
    height: 24px;
}

.toolbar-extensions .button-toolbar > button,
.profile-popup button {
    width: auto !important;
    min-width: 24px;
    height: auto !important;
    min-height: 24px;
    padding-inline: 0 !important;
}

.startpage,
#vivaldi-start-page,
.newtab-page,
.sdwrapper {
    background-color: var(--md-surface) !important;
    background-image: var(--md-wallpaper) !important;
    background-size: cover !important;
    background-position: center !important;
    background-attachment: fixed !important;
    color: var(--md-on-surface) !important;
}

.startpage .SearchField,
.sdwrapper .SearchField,
.SpeedDialView-SearchField {
    background-color: transparent !important;
    background-image:
        linear-gradient(
            color-mix(in srgb, var(--md-surface-container-highest) var(--md-transparency, 85%), transparent),
            color-mix(in srgb, var(--md-surface-container-highest) var(--md-transparency, 85%), transparent)
        ),
        var(--md-wallpaper) !important;
    background-size: cover !important;
    background-position: center !important;
    background-attachment: fixed !important;
    backdrop-filter: blur(var(--md-blur, 40px)) !important;
    border: 1px solid var(--md-outline-variant) !important;
    border-radius: var(--md-radius-full, 9999px) !important;
    box-shadow: none !important;
    color: var(--md-on-surface) !important;
}

.startpage .SearchField:focus-within,
.sdwrapper .SearchField:focus-within,
.SpeedDialView-SearchField:focus-within {
    outline: 2px solid var(--md-primary) !important;
    border-color: var(--md-primary) !important;
}

.startpage .speeddial,
.startpage .widget,
.startpage .SpeedDial {
    background-color: color-mix(in srgb, var(--md-surface-container) var(--md-transparency, 85%), transparent) !important;
    border: 1px solid var(--md-outline-variant) !important;
    border-radius: var(--md-radius-md, 16px) !important;
    margin: var(--md-space-md, 12px) !important;
}

.webpageview {
    border-radius: var(--md-radius-md, 16px);
}

dialog,
.dialog,
#status_bar {
    background-color: var(--md-surface-container-high) !important;
    color: var(--md-on-surface) !important;
    border-radius: var(--md-radius-md, 16px) !important;
}

button,
.button-toolbar {
    color: var(--md-on-surface) !important;
}
