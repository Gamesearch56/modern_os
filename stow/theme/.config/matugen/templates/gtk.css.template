/* GENERATED by scripts/theme-apply.sh (matugen) — do not hand-edit.
   Shared between GTK3 and GTK4 output paths (see config.toml). Selection
   color derives from primary — the old Wallust setup hardcoded #FFFFFF
   here (docs/DECISIONS.md #2). */

@define-color window_bg_color {{colors.surface.default.hex}};
@define-color window_fg_color {{colors.on_surface.default.hex}};
@define-color view_bg_color {{colors.surface_container_low.default.hex}};
@define-color view_fg_color {{colors.on_surface.default.hex}};
@define-color headerbar_bg_color {{colors.surface_container.default.hex}};
@define-color headerbar_fg_color {{colors.on_surface.default.hex}};
@define-color accent_bg_color {{colors.primary.default.hex}};
@define-color accent_fg_color {{colors.on_primary.default.hex}};
@define-color accent_color {{colors.primary.default.hex}};
@define-color selected_bg_color {{colors.primary_container.default.hex}};
@define-color selected_fg_color {{colors.on_primary_container.default.hex}};
@define-color destructive_bg_color {{colors.error.default.hex}};
@define-color destructive_fg_color {{colors.on_error.default.hex}};
@define-color card_bg_color {{colors.surface_container_low.default.hex}};
@define-color card_fg_color {{colors.on_surface.default.hex}};
@define-color popover_bg_color {{colors.surface_container_high.default.hex}};
@define-color popover_fg_color {{colors.on_surface.default.hex}};
@define-color borders {{colors.outline_variant.default.hex}};

window, .background {
    border-radius: @RADIUS_MD@px;
}

button {
    background-color: @card_bg_color;
    color: @window_fg_color;
    border-radius: 9999px;
    padding: 8px 16px;
}

button.suggested-action, .suggested-action {
    background-color: @accent_bg_color;
    color: @accent_fg_color;
}

button.destructive-action, .destructive-action {
    background-color: @destructive_bg_color;
    color: @destructive_fg_color;
}

.sidebar row:selected, list row:selected {
    background-color: @accent_bg_color;
    color: @accent_fg_color;
    border-radius: 9999px;
}
