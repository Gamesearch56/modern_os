/* GENERATED by scripts/theme-apply.sh (matugen) — do not hand-edit.
   Shared between GTK3 and GTK4 output paths (see config.toml). Selection
   color derives from primary — the old Wallust setup hardcoded #FFFFFF
   here (docs/DECISIONS.md #2). Libadwaita named colors (Nautilus) and
   GTK3 Adwaita aliases (Sushi) follow the same MD3 roles as the shell. */

@define-color window_bg_color {{colors.surface.default.hex}};
@define-color window_fg_color {{colors.on_surface.default.hex}};
@define-color view_bg_color {{colors.surface_container_low.default.hex}};
@define-color view_fg_color {{colors.on_surface.default.hex}};
@define-color headerbar_bg_color {{colors.surface_container.default.hex}};
@define-color headerbar_fg_color {{colors.on_surface.default.hex}};
@define-color headerbar_border_color {{colors.outline_variant.default.hex}};
@define-color headerbar_backdrop_color {{colors.surface.default.hex}};
@define-color headerbar_shade_color {{colors.surface_container.default.hex}};
@define-color sidebar_bg_color {{colors.surface_container.default.hex}};
@define-color sidebar_fg_color {{colors.on_surface.default.hex}};
@define-color sidebar_backdrop_color {{colors.surface.default.hex}};
@define-color sidebar_border_color {{colors.outline_variant.default.hex}};
@define-color accent_bg_color {{colors.primary.default.hex}};
@define-color accent_fg_color {{colors.on_primary.default.hex}};
@define-color accent_color {{colors.primary.default.hex}};
@define-color selected_bg_color {{colors.primary_container.default.hex}};
@define-color selected_fg_color {{colors.on_primary_container.default.hex}};
@define-color destructive_color {{colors.error.default.hex}};
@define-color destructive_bg_color {{colors.error.default.hex}};
@define-color destructive_fg_color {{colors.on_error.default.hex}};
@define-color error_color {{colors.error.default.hex}};
@define-color error_bg_color {{colors.error.default.hex}};
@define-color error_fg_color {{colors.on_error.default.hex}};
@define-color card_bg_color {{colors.surface_container_low.default.hex}};
@define-color card_fg_color {{colors.on_surface.default.hex}};
@define-color dialog_bg_color {{colors.surface_container_high.default.hex}};
@define-color dialog_fg_color {{colors.on_surface.default.hex}};
@define-color popover_bg_color {{colors.surface_container_high.default.hex}};
@define-color popover_fg_color {{colors.on_surface.default.hex}};
@define-color borders {{colors.outline_variant.default.hex}};
@define-color shade_color {{colors.surface_container.default.hex}};
@define-color theme_bg_color {{colors.surface.default.hex}};
@define-color theme_fg_color {{colors.on_surface.default.hex}};
@define-color theme_base_color {{colors.surface_container_low.default.hex}};
@define-color theme_text_color {{colors.on_surface.default.hex}};
@define-color theme_selected_bg_color {{colors.primary.default.hex}};
@define-color theme_selected_fg_color {{colors.on_primary.default.hex}};
@define-color theme_unfocused_bg_color {{colors.surface.default.hex}};
@define-color theme_unfocused_fg_color {{colors.on_surface.default.hex}};
@define-color theme_unfocused_base_color {{colors.surface_container_low.default.hex}};
@define-color theme_unfocused_text_color {{colors.on_surface.default.hex}};
@define-color theme_unfocused_selected_bg_color {{colors.primary_container.default.hex}};
@define-color theme_unfocused_selected_fg_color {{colors.on_primary_container.default.hex}};
@define-color insensitive_bg_color {{colors.surface_container.default.hex}};
@define-color insensitive_fg_color {{colors.on_surface_variant.default.hex}};
@define-color insensitive_base_color {{colors.surface_container.default.hex}};
@define-color warning_color {{colors.tertiary.default.hex}};
@define-color success_color {{colors.primary.default.hex}};

button.suggested-action, .suggested-action {
    background-color: @accent_bg_color;
    color: @accent_fg_color;
}

button.destructive-action, .destructive-action {
    background-color: @destructive_bg_color;
    color: @destructive_fg_color;
}

.sidebar row:selected, list row:selected {
    background-color: @accent_bg_color;
    color: @accent_fg_color;
    border-radius: @RADIUS_MD@px;
}

.nautilus-window {
    background-color: @window_bg_color;
    color: @window_fg_color;
}

.nautilus-window .sidebar,
.nautilus-window flap,
.nautilus-window .navigation-sidebar {
    background-color: @sidebar_bg_color;
    color: @sidebar_fg_color;
}

.nautilus-window gridview,
.nautilus-window listview,
.nautilus-window .view {
    background-color: @view_bg_color;
    color: @view_fg_color;
}

.nautilus-window gridview > child:selected,
.nautilus-window listview > row:selected,
.nautilus-window .view:selected {
    background-color: @selected_bg_color;
    color: @selected_fg_color;
    border-radius: @RADIUS_MD@px;
}

/* Do not round `window` here. Hyprland already rounds the surface;
   GTK `border-radius` on the window node paints a repeating 1px-wide
   tile that shows up as vertical stripes in the header. */
.nautilus-window headerbar,
.nautilus-window .header-bar,
.nautilus-window .top-bar {
    background-color: @headerbar_bg_color;
    background-image: none;
    background-repeat: no-repeat;
    box-shadow: none;
    border: none;
    border-bottom: none;
}

.nautilus-window headerbar button,
.nautilus-window .header-bar button {
    background-image: none;
    box-shadow: none;
    border: none;
    border-radius: 9999px;
    padding: 4px;
    min-width: 24px;
    min-height: 24px;
    background-color: transparent;
}

.nautilus-window headerbar button:hover,
.nautilus-window .header-bar button:hover {
    background-color: alpha(@headerbar_fg_color, 0.08);
}

.nautilus-window headerbar button:active,
.nautilus-window headerbar button:checked,
.nautilus-window .header-bar button:active,
.nautilus-window .header-bar button:checked {
    background-color: alpha(@headerbar_fg_color, 0.12);
}

.nautilus-window headerbar .raised,
.nautilus-window .path-bar-box,
.nautilus-window .pathbar,
.nautilus-window .nautilus-path-bar,
.nautilus-window headerbar entry,
.nautilus-window .header-bar entry,
.nautilus-window searchbar > revealer > box {
    background-color: @dialog_bg_color;
    background-image: none;
    color: @headerbar_fg_color;
    border: none;
    box-shadow: none;
    outline: none;
    border-radius: 9999px;
    min-height: 32px;
    padding: 4px 12px;
}

.nautilus-window .nautilus-path-bar button,
.nautilus-window .path-bar button {
    background-color: transparent;
    border-radius: 9999px;
}

.nautilus-window .nautilus-path-bar button:hover,
.nautilus-window .path-bar button:hover {
    background-color: alpha(@headerbar_fg_color, 0.08);
}

.nautilus-window .navigation-sidebar row > button,
.nautilus-window .sidebar row > button,
.nautilus-window .navigation-sidebar button.image-button,
.nautilus-window .sidebar button.image-button,
.nautilus-window .navigation-sidebar button.circular,
.nautilus-window .sidebar button.circular,
.nautilus-window .navigation-sidebar button.flat,
.nautilus-window .sidebar button.flat {
    min-width: 16px;
    min-height: 16px;
    padding: 2px;
    border: none;
    box-shadow: none;
    border-radius: 9999px;
    background-color: transparent;
}

.nautilus-window .navigation-sidebar button:hover,
.nautilus-window .sidebar button:hover {
    background-color: alpha(@sidebar_fg_color, 0.08);
}

/* Sushi OSD + headerbar (GTK3). Do not round `window` — Hyprland rounds. */
toolbar.osd,
.osd {
    background-color: @dialog_bg_color;
    color: @dialog_fg_color;
    border: none;
    box-shadow: none;
    border-radius: @RADIUS_MD@px;
}

headerbar {
    background-color: @headerbar_bg_color;
    color: @headerbar_fg_color;
    background-image: none;
    box-shadow: none;
    border: none;
}
