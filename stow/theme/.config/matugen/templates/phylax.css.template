/* GENERATED by scripts/theme-apply.sh (matugen) — do not hand-edit.
   Phylax GTK4 polkit dialog (~/.config/phylax/style.css). Hot-reloads
   when the prompt maps; do not restart the agent on a palette swap.
   @FONT_UI@ / @FONT_SIZE@ / @RADIUS_*@ / @SPACE_*@ are patched after
   matugen from config.json (same Tokens grid as gtk.css). GTK4 has no
   !important — keep selectors at least as specific as this. Adwaita
   buttons use background-image; unset it or Confirm stays unfilled. */

window.auth-window.background,
window.auth-window {
    background-color: {{colors.surface.default.hex}};
    color: {{colors.on_surface.default.hex}};
    font-family: "@FONT_UI@";
    font-size: @FONT_SIZE@px;
    border-radius: @RADIUS_MD@px;
    padding: @SPACE_LG@px;
}

.auth-container {
    background-color: {{colors.surface.default.hex}};
}

.auth-header {
    color: {{colors.on_surface.default.hex}};
    font-weight: 500;
}

.auth-message {
    color: {{colors.on_surface_variant.default.hex}};
}

.auth-retry {
    color: {{colors.error.default.hex}};
}

dropdown.auth-identity > button.toggle {
    background: none;
    background-color: {{colors.surface_container_highest.default.hex}};
    border: 1px solid {{colors.outline_variant.default.hex}};
    border-radius: @RADIUS_MD@px;
    color: {{colors.on_surface.default.hex}};
}

dropdown.auth-identity > popover.menu > contents,
dropdown.auth-identity listview {
    background-color: {{colors.surface_container_high.default.hex}};
    border-color: {{colors.outline_variant.default.hex}};
    color: {{colors.on_surface.default.hex}};
}

dropdown.auth-identity listview > row:hover,
dropdown.auth-identity listview > row:selected {
    background-color: {{colors.primary_container.default.hex}};
    color: {{colors.on_primary_container.default.hex}};
}

entry.auth-password,
.auth-password {
    background-color: {{colors.surface_container_highest.default.hex}};
    border: 1px solid {{colors.outline.default.hex}};
    border-radius: @RADIUS_MD@px;
    color: {{colors.on_surface.default.hex}};
    padding: @SPACE_SM@px @SPACE_MD@px;
}

entry.auth-password:focus-within {
    outline-color: {{colors.primary.default.hex}};
    border-color: {{colors.primary.default.hex}};
}

.auth-buttons {
    margin-top: @SPACE_SM@px;
}

window.auth-window flowbox.auth-buttons > flowboxchild {
    background: none;
    box-shadow: none;
    padding: 0;
}

window.auth-window flowbox.auth-buttons > flowboxchild + flowboxchild {
    margin-left: @SPACE_MD@px;
}

window.auth-window flowbox.auth-buttons > flowboxchild > button.auth-cancel,
window.auth-window button.auth-cancel {
    background-image: none;
    background-color: transparent;
    box-shadow: none;
    outline: none;
    cursor: pointer;
    border: 1px solid {{colors.outline.default.hex}};
    border-radius: @RADIUS_FULL@px;
    color: {{colors.on_surface.default.hex}};
    padding: @SPACE_SM@px @SPACE_LG@px;
}
}

window.auth-window flowbox.auth-buttons > flowboxchild > button.auth-cancel:hover,
window.auth-window button.auth-cancel:hover {
    background-image: none;
    background-color: alpha({{colors.on_surface.default.hex}}, 0.08);
    color: {{colors.on_surface.default.hex}};
    cursor: pointer;
}

window.auth-window flowbox.auth-buttons > flowboxchild > button.auth-confirm,
window.auth-window button.auth-confirm,
window.auth-window button.auth-confirm.suggested-action {
    background-image: none;
    background-color: {{colors.primary.default.hex}};
    box-shadow: none;
    outline: none;
    cursor: pointer;
    border: 1px solid {{colors.primary.default.hex}};
    border-radius: @RADIUS_FULL@px;
    color: {{colors.on_primary.default.hex}};
    padding: @SPACE_SM@px @SPACE_LG@px;
}
}

window.auth-window flowbox.auth-buttons > flowboxchild > button.auth-confirm:hover,
window.auth-window button.auth-confirm:hover,
window.auth-window button.auth-confirm.suggested-action:hover {
    background-image: none;
    background-color: {{colors.primary_container.default.hex}};
    border-color: {{colors.primary_container.default.hex}};
    color: {{colors.on_primary_container.default.hex}};
    cursor: pointer;
}
