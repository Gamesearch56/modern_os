/* GENERATED by scripts/theme-apply.sh (matugen) — do not hand-edit.
   @FONT_UI@ / @RADIUS_*@ / @SPACE_*@ are replaced after matugen from
   config.json (same 8/16/28 rounding and 4px grid as Tokens.qml). */
QWidget {
    background-color: {{colors.surface.default.hex}};
    color: {{colors.on_surface.default.hex}};
    font-family: "@FONT_UI@";
}

QToolBar, QStatusBar, QMenuBar {
    background-color: {{colors.surface_container.default.hex}};
    border: none;
}

QTreeView, QListView, QTableView {
    background-color: {{colors.surface_container_low.default.hex}};
    alternate-background-color: {{colors.surface_container.default.hex}};
    selection-background-color: {{colors.primary_container.default.hex}};
    selection-color: {{colors.on_primary_container.default.hex}};
    border: none;
    outline: none;
}

QHeaderView::section {
    background-color: {{colors.surface_container.default.hex}};
    color: {{colors.on_surface.default.hex}};
    padding: @SPACE_XS@px @SPACE_SM@px;
}

QLineEdit, QComboBox {
    background-color: {{colors.surface_container_highest.default.hex}};
    color: {{colors.on_surface.default.hex}};
    border: 1px solid {{colors.outline.default.hex}};
    border-radius: @RADIUS_FULL@px;
    padding: @SPACE_XS@px @SPACE_SM@px;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid {{colors.primary.default.hex}};
}

QPushButton {
    background-color: {{colors.primary_container.default.hex}};
    color: {{colors.on_primary_container.default.hex}};
    border: none;
    border-radius: @RADIUS_FULL@px;
    padding: @SPACE_XS@px @SPACE_MD@px;
}

QPushButton:default, QPushButton:focus {
    background-color: {{colors.primary.default.hex}};
    color: {{colors.on_primary.default.hex}};
}

QPushButton:disabled {
    color: {{colors.on_surface_variant.default.hex}};
}

QPushButton:hover {
    border: 1px solid {{colors.outline.default.hex}};
}

QSlider::groove:horizontal {
    height: 8px;
    background: {{colors.surface_container_highest.default.hex}};
    border-radius: @RADIUS_FULL@px;
}

QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -6px 0;
    background: {{colors.primary.default.hex}};
    border-radius: @RADIUS_FULL@px;
}

DolphinPlacesView QListView::item:selected, QListView#placesView::item:selected {
    background-color: {{colors.primary.default.hex}};
    color: {{colors.on_primary.default.hex}};
    border-radius: @RADIUS_FULL@px;
}

QLineEdit {
    background-color: {{colors.surface_container_highest.default.hex}};
    color: {{colors.on_surface.default.hex}};
    border: 1px solid {{colors.outline.default.hex}};
    border-radius: @RADIUS_FULL@px;
    padding: @SPACE_XS@px @SPACE_MD@px;
}

QLineEdit:focus {
    border: 2px solid {{colors.primary.default.hex}};
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: @SPACE_SM@px;
    height: @SPACE_SM@px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: {{colors.outline.default.hex}};
    border-radius: @RADIUS_FULL@px;
}

QMenu {
    background-color: {{colors.surface_container.default.hex}};
    color: {{colors.on_surface.default.hex}};
    border-radius: @RADIUS_SM@px;
}

QSplitter::handle {
    background: {{colors.outline_variant.default.hex}};
}

QTabBar::tab {
    background: {{colors.surface_container.default.hex}};
    color: {{colors.on_surface.default.hex}};
    padding: @SPACE_SM@px @SPACE_MD@px;
    border-radius: @RADIUS_SM@px;
}

QTabBar::tab:selected {
    background: {{colors.primary_container.default.hex}};
    color: {{colors.on_primary_container.default.hex}};
}
