/* GENERATED by scripts/theme-apply.sh (matugen) — do not hand-edit.
   @FONT_UI@ / @RADIUS_*@ / @SPACE_*@ are replaced after matugen from
   config.json (same 8/16/28 rounding and 4px grid as Tokens.qml).

   Not loaded: qt6ct.conf leaves stylesheets empty. Applying this file
   app-wide makes Fusion drop the custom Active palette (white file
   grid on focus, unreadable Places text). Palette-only is the fix. */
QWidget {
    font-family: "@FONT_UI@";
}

QMenuBar {
    max-height: 0px;
    border: none;
}

QToolBar, QStatusBar, DolphinStatusBar {
    background-color: {{colors.surface_container.default.hex}};
    border: none;
    padding: @SPACE_XS@px;
    spacing: @SPACE_XS@px;
}

QToolBar QToolButton {
    background-color: {{colors.surface_container.default.hex}};
    border: none;
    border-radius: @RADIUS_FULL@px;
    padding: @SPACE_XS@px;
    min-width: @SPACE_XL@px;
    min-height: @SPACE_XL@px;
}

QToolBar QToolButton:hover,
KUrlNavigator QToolButton:hover, DolphinUrlNavigator QToolButton:hover {
    background-color: {{colors.primary_container.default.hex}};
}

QToolBar QToolButton:checked, QToolBar QToolButton:pressed {
    background-color: {{colors.primary.default.hex}};
}

QLineEdit, QComboBox, KUrlNavigator, DolphinUrlNavigator {
    background-color: {{colors.surface_container_highest.default.hex}};
    border: 1px solid {{colors.outline_variant.default.hex}};
    border-radius: @RADIUS_FULL@px;
    padding: @SPACE_XS@px @SPACE_MD@px;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid {{colors.primary.default.hex}};
}

QPushButton {
    background-color: {{colors.primary_container.default.hex}};
    border: none;
    border-radius: @RADIUS_FULL@px;
    padding: @SPACE_XS@px @SPACE_MD@px;
}

QPushButton:default, QPushButton:focus {
    background-color: {{colors.primary.default.hex}};
}

QPushButton:hover {
    border: 1px solid {{colors.outline.default.hex}};
}

QSlider::groove:horizontal {
    height: 8px;
    background: {{colors.surface_container_highest.default.hex}};
    border-radius: @RADIUS_FULL@px;
}

QSlider::handle:horizontal {
    width: 20px;
    height: 20px;
    margin: -6px 0;
    background: {{colors.primary.default.hex}};
    border-radius: @RADIUS_FULL@px;
}

KFilePlacesView, DolphinPlacesView, QListView#placesView {
    background-color: {{colors.surface_container.default.hex}};
    border: none;
    padding: @SPACE_SM@px @SPACE_XS@px;
}

KFilePlacesView::item, DolphinPlacesView::item, QListView#placesView::item {
    background: transparent;
    border-radius: @RADIUS_FULL@px;
    padding: @SPACE_SM@px @SPACE_MD@px;
    margin: 2px 0;
    min-height: 28px;
}

KFilePlacesView::item:hover, DolphinPlacesView::item:hover, QListView#placesView::item:hover {
    background-color: {{colors.surface_container_high.default.hex}};
}

KFilePlacesView::item:selected, DolphinPlacesView::item:selected, QListView#placesView::item:selected {
    background-color: {{colors.primary.default.hex}};
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: @SPACE_SM@px;
    height: @SPACE_SM@px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: {{colors.outline.default.hex}};
    border-radius: @RADIUS_FULL@px;
    min-height: @SPACE_LG@px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QMenu {
    background-color: {{colors.surface_container.default.hex}};
    border: 1px solid {{colors.outline_variant.default.hex}};
    border-radius: @RADIUS_SM@px;
    padding: @SPACE_XS@px;
}

QMenu::item {
    border-radius: @RADIUS_FULL@px;
    padding: @SPACE_XS@px @SPACE_MD@px;
}

QMenu::item:selected {
    background-color: {{colors.primary_container.default.hex}};
}

QSplitter::handle {
    background: {{colors.outline_variant.default.hex}};
}

QTabBar::tab {
    background: {{colors.surface_container.default.hex}};
    padding: @SPACE_SM@px @SPACE_MD@px;
    border-radius: @RADIUS_FULL@px;
    margin: @SPACE_XS@px;
}

QTabBar::tab:selected {
    background: {{colors.primary.default.hex}};
}
