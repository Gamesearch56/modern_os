; GENERATED by scripts/theme-apply.sh (matugen) — do not hand-edit.
; Read by KDE Frameworks apps (Dolphin) even outside a Plasma session.
[General]
ColorScheme=modern

; KF6 KColorSchemeManager (Dolphin, etc.) does not use qt6ct's QPalette.
; Off Plasma it maps Qt::ColorScheme::Unknown (what qt6ct reports) to the
; built-in light scheme, so the focused window goes white while Inactive
; still shows our colors. Pin the scheme id so createApplicationPalette
; loads ~/.local/share/color-schemes/modern.colors for Active too.
[UiSettings]
ColorScheme=modern

[KDE]
widgetStyle=qt6ct-style

; kdeglobals stores colors as bare "R,G,B" triplets, not CSS rgb().
