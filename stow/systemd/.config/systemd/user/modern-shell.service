[Unit]
Description=modern Quickshell desktop shell
After=graphical-session.target
# Not PartOf=graphical-session.target: a TTY start without UWSM never
# reaches that target, and PartOf would stop the shell immediately.

[Service]
# -p points at the stowed config dir (~/.config/quickshell/modern).
# %h is the systemd home specifier so this unit is user-portable.
ExecStart=quickshell -p %h/.config/quickshell/modern
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
