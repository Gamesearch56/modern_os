<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
  </theme>
  <keyboard>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
  </keyboard>
  <mouse>
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Click">
        <action name="Close"/>
      </mousebind>
    </context>
  </mouse>
  <applications>
    <application class="calamares">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <layer>below</layer>
    </application>
    <application class="Calamares">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <layer>below</layer>
    </application>
    <application class="firefox">
      <decor>yes</decor>
      <maximized>no</maximized>
      <layer>above</layer>
    </application>
    <application class="Firefox">
      <decor>yes</decor>
      <maximized>no</maximized>
      <layer>above</layer>
    </application>
  </applications>
</openbox_config>
