  "branding": [
    { "context": "show", "source": "The Super key", "key": "installer.slides.superTitle" },
    {
      "context": "show",
      "source": "Super is the key with the Windows logo, between Ctrl and Alt. Most shortcuts on this desktop start while you hold it.",
      "key": "installer.slides.super"
    },
    { "context": "show", "source": "Open an app", "key": "installer.slides.launcherTitle" },
    {
      "context": "show",
      "source": "Super+Space opens the launcher. Type a few letters of the app name and press Enter.",
      "key": "installer.slides.launcher"
    },
    { "context": "show", "source": "The bar and the dock", "key": "installer.slides.barTitle" },
    {
      "context": "show",
      "source": "The bar along the top shows the clock, sound, and network. The dock along the bottom holds the apps you open often. Click one to start it.",
      "key": "installer.slides.bar"
    },
    { "context": "show", "source": "Close a window", "key": "installer.slides.closeTitle" },
    {
      "context": "show",
      "source": "Super+Q closes the window in front of you. Super+F fills the screen with it. Press Super+F again to bring it back to its old size.",
      "key": "installer.slides.close"
    },
    { "context": "show", "source": "Move between windows", "key": "installer.slides.windowsTitle" },
    {
      "context": "show",
      "source": "Hold Super and press an arrow key to jump to the window in that direction. Add Shift to slide the window itself. Super+Tab shows every window.",
      "key": "installer.slides.windows"
    },
    { "context": "show", "source": "More than one desk", "key": "installer.slides.desksTitle" },
    {
      "context": "show",
      "source": "Super and a number key from 1 to 0 switches workspace, like another desk. Super+Shift and that number takes the current window with you. Use the number row, not the number pad.",
      "key": "installer.slides.desks"
    },
    { "context": "show", "source": "Save a picture of the screen", "key": "installer.slides.shotTitle" },
    {
      "context": "show",
      "source": "Print lets you drag around an area. Shift+Print captures the window. Super+Print captures the whole screen. The pictures are saved in Pictures.",
      "key": "installer.slides.shot"
    },
    { "context": "show", "source": "Sound, light, and Wi-Fi", "key": "installer.slides.soundTitle" },
    {
      "context": "show",
      "source": "The volume and brightness keys on the keyboard work as usual. Super+N opens a panel for Wi-Fi, Bluetooth, sound, and brightness.",
      "key": "installer.slides.sound"
    },
    { "context": "show", "source": "Lock and shut down", "key": "installer.slides.powerTitle" },
    {
      "context": "show",
      "source": "Super+L locks the screen. Super+M opens the menu for sleep, restart, and shut down.",
      "key": "installer.slides.power"
    },
    { "context": "show", "source": "A new wallpaper", "key": "installer.slides.colorsTitle" },
    {
      "context": "show",
      "source": "Super+W picks a wallpaper. The bar, the apps, and the login screen take their colors from that picture.",
      "key": "installer.slides.colors"
    },
    { "context": "show", "source": "Every shortcut, listed", "key": "installer.slides.keysTitle" },
    {
      "context": "show",
      "source": "Super+K opens the list of shortcuts. Type what you want to do, then press the keys it shows.",
      "key": "installer.slides.keys"
    },
    { "context": "show", "source": "Change a setting", "key": "installer.slides.settingsTitle" },
    {
      "context": "show",
      "source": "Super+I opens Settings. Language, keyboard, displays, the dock, and updates are all in there.",
      "key": "installer.slides.settings"
    },
    { "context": "show", "source": "Files and the browser", "key": "installer.slides.filesTitle" },
    {
      "context": "show",
      "source": "Super+E opens your files. Super+B opens the browser. In Files, Delete moves something to the Trash, and you can restore it from there.",
      "key": "installer.slides.files"
    },
    { "context": "show", "source": "Install an app", "key": "installer.slides.storeTitle" },
    {
      "context": "show",
      "source": "Open the App Store from the dock or the launcher. Search for a program, open it, and confirm. It is installed when the button changes.",
      "key": "installer.slides.store"
    },
    { "context": "show", "source": "Your language", "key": "installer.slides.languageTitle" },
    {
      "context": "show",
      "source": "The desktop starts in the language and keyboard layout you chose here. You can change both later in Settings.",
      "key": "installer.slides.language"
    },
    { "context": "show", "source": "After the restart", "key": "installer.slides.rebootTitle" },
    {
      "context": "show",
      "source": "Remove the USB stick while the computer restarts. Sign in with the name and password you just created.",
      "key": "installer.slides.reboot"
    },
    { "context": "show", "source": "If something looks wrong", "key": "installer.slides.helpTitle" },
    {
      "context": "show",
      "source": "Super+# opens a short form to report a problem. Super+Y opens the Manual, which explains the desktop in plain language.",
      "key": "installer.slides.help"
    }
  ]
}
