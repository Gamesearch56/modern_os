# Overlay on top of archiso releng. Live boot stays stock linux; linux-zen
# is on the image so unpackfs already has /vmlinuz-linux-zen (bootloader.conf)
# and packages.conf does not have to download it. Package names must be the
# whole line. mkarchiso keeps trailing spaces as part of the pacman target
# (v0.1.2 failed as "calamares                       ").
linux-zen
linux-zen-headers
hyprland
hyprland-guiutils
quickshell
# AUR: built into a local repo by iso-build.sh (packages.aur.x86_64).
calamares
yay
matugen-bin
bibata-cursor-theme-bin
phylax-git
# AUR calamares PKGBUILD omits this; the binary links libKF6Crash.so.6.
kcrash
cage
xorg-xwayland
xorg-xhost
xorg-setxkbmap
openbox
qt6-declarative
qt6-translations
networkmanager
iwd
# NetworkManager ipv4.method shared (live-wifi-sim.sh APs) needs this.
dnsmasq
mesa
git
sudo
base-devel
awww
inter-font
ttf-jetbrains-mono-nerd
noto-fonts
noto-fonts-emoji
greetd
polkit
qt6-wayland
btrfs-progs
efibootmgr
xdg-utils
firefox
# PipeWire stack on the squashfs so unpackfs already provides virtual
# `jack` / pulse. Otherwise install.sh's one pacman -S picks jack2.
pipewire
pipewire-alsa
pipewire-jack
pipewire-pulse
wireplumber
