# Installer colors, baked into the initramfs. #141218 surface, #D0BCFF word.
# Plymouth's script module has Image.Text, Sprite, and Math. A call it
# does not know aborts the theme, and the cleared framebuffer stays black
# for the whole boot and shutdown.
# A palette or wallpaper change must not rewrite this file: the image
# would have to be rebuilt, and a missing picture would break boot.
Window.SetBackgroundTopColor(0.0784, 0.0706, 0.0941);
Window.SetBackgroundBottomColor(0.0784, 0.0706, 0.0941);

title.image = Image.Text("ModernOS", 0.8157, 0.7373, 1.0, 1.0, "Sans 120", "center");
title.sprite = Sprite(title.image);

# Dots orbit under the word. Opacity is fixed per dot, so the bright
# one travels with the ring. New images each frame would leak for a long boot.
spin_count = 12;
spin_radius = 42;
spin_gap = 56;
spin_phase = 0;
for (i = 0; i < spin_count; i++)
  {
    dots[i].image = Image.Text("●", 0.8157, 0.7373, 1.0, 1.0, "Sans 22", "center");
    dots[i].sprite = Sprite(dots[i].image);
  }

fun refresh_callback()
  {
    spin_phase = spin_phase + 0.09;
    cx = Window.GetX() + Window.GetWidth() / 2;
    top = Window.GetY() + Window.GetHeight() / 2 - (title.image.GetHeight() + spin_gap + spin_radius * 2) / 2;
    title.sprite.SetX(cx - title.image.GetWidth() / 2);
    title.sprite.SetY(top);
    sy = top + title.image.GetHeight() + spin_gap + spin_radius;
    for (i = 0; i < spin_count; i++)
      {
        ang = spin_phase + i * (2 * Math.Pi / spin_count);
        dots[i].sprite.SetX(cx + Math.Cos(ang) * spin_radius - dots[i].image.GetWidth() / 2);
        dots[i].sprite.SetY(sy + Math.Sin(ang) * spin_radius - dots[i].image.GetHeight() / 2);
        dots[i].sprite.SetOpacity(0.2 + 0.8 * i / (spin_count - 1));
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);
