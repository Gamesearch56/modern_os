# Default splash. RGB values match the MD3 dark baseline in Commons/Colors.qml
# so the theme paints before the first plymouth-sync.sh run. That script
# rewrites these three assignments from tokens.json — never edit the
# numbers here to "theme" a machine; run plymouth-sync.sh and copy the
# generated files (docs/DECISIONS.md #13).
Window.SetBackgroundTopColor(0.0784, 0.0706, 0.0941);
Window.SetBackgroundBottomColor(0.0784, 0.0706, 0.0941);

fun progress_callback(duration, progress) {
    # progress is 0.0–1.0; a later generated script draws a primary-colored
    # bar. The stock script keeps the splash a solid surface so a missing
    # wallpaper-boot.jpg cannot leave a broken initramfs.
}

Plymouth.SetBootProgressFunction(progress_callback);
