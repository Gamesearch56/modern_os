# Installer colors, baked into the initramfs. #141218 surface, #D0BCFF bar.
# A palette or wallpaper change must not rewrite this file: the image
# would have to be rebuilt, and a missing picture would break boot.
Window.SetBackgroundTopColor(0.0784, 0.0706, 0.0941);
Window.SetBackgroundBottomColor(0.0784, 0.0706, 0.0941);

progress_box = Image.Box(0.8157, 0.7373, 1.0000);
progress_box.SetPosition(Window.GetWidth() * 0.2, Window.GetHeight() * 0.82, 0);
progress_box.SetSize(1, 8);

fun progress_callback(duration, progress) {
    progress_box.SetSize(Window.GetWidth() * 0.6 * progress, 8);
}

Plymouth.SetBootProgressFunction(progress_callback);
