*filter
:ufw-user-input - [0:0]
:ufw-user-output - [0:0]
:ufw-user-forward - [0:0]
:ufw-before-logging-input - [0:0]
:ufw-before-logging-output - [0:0]
:ufw-before-logging-forward - [0:0]
:ufw-user-logging-input - [0:0]
:ufw-user-logging-output - [0:0]
:ufw-user-logging-forward - [0:0]
:ufw-after-logging-input - [0:0]
:ufw-after-logging-output - [0:0]
:ufw-after-logging-forward - [0:0]
:ufw-logging-deny - [0:0]
:ufw-logging-allow - [0:0]
:ufw-user-limit - [0:0]
:ufw-user-limit-accept - [0:0]
### RULES ###

### tuple ### allow tcp 1714:1764 0.0.0.0/0 any 10.0.0.0/8 in comment=6b6465636f6e6e656374
-A ufw-user-input -p tcp -m multiport --dports 1714:1764 -s 10.0.0.0/8 -j ACCEPT

### tuple ### allow udp 1714:1764 0.0.0.0/0 any 10.0.0.0/8 in comment=6b6465636f6e6e656374
-A ufw-user-input -p udp -m multiport --dports 1714:1764 -s 10.0.0.0/8 -j ACCEPT

### tuple ### allow tcp 27036,27037,27040 0.0.0.0/0 any 10.0.0.0/8 in comment=737465616d
-A ufw-user-input -p tcp -m multiport --dports 27036,27037,27040 -s 10.0.0.0/8 -j ACCEPT

### tuple ### allow udp 27031,27036 0.0.0.0/0 any 10.0.0.0/8 in comment=737465616d
-A ufw-user-input -p udp -m multiport --dports 27031,27036 -s 10.0.0.0/8 -j ACCEPT

### tuple ### allow tcp 1714:1764 0.0.0.0/0 any 172.16.0.0/12 in comment=6b6465636f6e6e656374
-A ufw-user-input -p tcp -m multiport --dports 1714:1764 -s 172.16.0.0/12 -j ACCEPT

### tuple ### allow udp 1714:1764 0.0.0.0/0 any 172.16.0.0/12 in comment=6b6465636f6e6e656374
-A ufw-user-input -p udp -m multiport --dports 1714:1764 -s 172.16.0.0/12 -j ACCEPT

### tuple ### allow tcp 27036,27037,27040 0.0.0.0/0 any 172.16.0.0/12 in comment=737465616d
-A ufw-user-input -p tcp -m multiport --dports 27036,27037,27040 -s 172.16.0.0/12 -j ACCEPT

### tuple ### allow udp 27031,27036 0.0.0.0/0 any 172.16.0.0/12 in comment=737465616d
-A ufw-user-input -p udp -m multiport --dports 27031,27036 -s 172.16.0.0/12 -j ACCEPT

### tuple ### allow tcp 1714:1764 0.0.0.0/0 any 192.168.0.0/16 in comment=6b6465636f6e6e656374
-A ufw-user-input -p tcp -m multiport --dports 1714:1764 -s 192.168.0.0/16 -j ACCEPT

### tuple ### allow udp 1714:1764 0.0.0.0/0 any 192.168.0.0/16 in comment=6b6465636f6e6e656374
-A ufw-user-input -p udp -m multiport --dports 1714:1764 -s 192.168.0.0/16 -j ACCEPT

### tuple ### allow tcp 27036,27037,27040 0.0.0.0/0 any 192.168.0.0/16 in comment=737465616d
-A ufw-user-input -p tcp -m multiport --dports 27036,27037,27040 -s 192.168.0.0/16 -j ACCEPT

### tuple ### allow udp 27031,27036 0.0.0.0/0 any 192.168.0.0/16 in comment=737465616d
-A ufw-user-input -p udp -m multiport --dports 27031,27036 -s 192.168.0.0/16 -j ACCEPT

### END RULES ###

### LOGGING ###
-A ufw-after-logging-input -j LOG --log-prefix "[UFW BLOCK] " -m limit --limit 3/min --limit-burst 10
-A ufw-after-logging-forward -j LOG --log-prefix "[UFW BLOCK] " -m limit --limit 3/min --limit-burst 10
-I ufw-logging-deny -m conntrack --ctstate INVALID -j RETURN -m limit --limit 3/min --limit-burst 10
-A ufw-logging-deny -j LOG --log-prefix "[UFW BLOCK] " -m limit --limit 3/min --limit-burst 10
-A ufw-logging-allow -j LOG --log-prefix "[UFW ALLOW] " -m limit --limit 3/min --limit-burst 10
### END LOGGING ###

### RATE LIMITING ###
-A ufw-user-limit -m limit --limit 3/minute -j LOG --log-prefix "[UFW LIMIT BLOCK] "
-A ufw-user-limit -j REJECT
-A ufw-user-limit-accept -j ACCEPT
### END RATE LIMITING ###
COMMIT
