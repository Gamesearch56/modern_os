# hardware.conf.example — sourced by scripts/bootstrap.sh
# Copy to install/hardware.conf (gitignored if you add secrets) and fill DISK=.
# bootstrap.sh defaults to dry-run and will not wipe a disk unless you pass
# --yes --disk /dev/X together.

DISK=
HOSTNAME=
USERNAME=devuser
TIMEZONE=Europe/Berlin
LOCALE=en_US.UTF-8
