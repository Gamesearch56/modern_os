# Generated theme output — regenerated by scripts/theme-apply.sh
stow/modern/.config/modern/tokens.json
stow/gtk/.config/gtk-3.0/gtk.css
# Written per-user by nautilus-prefs.sh (Downloads / Pictures / Videos).
stow/gtk/.config/gtk-3.0/bookmarks
stow/gtk/.config/gtk-4.0/gtk.css
stow/fastfetch/.config/fastfetch/config.jsonc
stow/qt/.config/qt6ct/qss/modern.qss
stow/qt/.config/qt6ct/colors/modern.conf
stow/hypr/.config/hypr/application-style.conf
stow/hypr/.config/hypr/hyprtoolkit.conf
stow/hypr/.config/hypr/modules/colors.lua
stow/kitty/.config/kitty/colors.conf
**/.config/kitty/colors.conf
**/.config/phylax/style.css
**/.cache/
**/__pycache__/
*.pyc

# Live config, not the shipped default
stow/modern/.config/modern/config.json
stow/modern/.config/modern/repo
# mktemp leftovers from config-set.sh / config-restore.sh (same-dir atomic write)
stow/modern/.config/modern/config.json.*
# Written by Services/IdleDaemon from general.idleTimings
stow/hypr/.config/hypr/hypridle.conf

# Secrets — never commit
**/secrets.json
# Private half of the read-only GitHub deploy key (and its .pub).
/secrets/
**/bashrc.local
**/*.local.json
**/battlenet.env
.gitconfig.local

# Local runtime/user state
install/baseline/
install/install.log
install/*.log
*.bak
*_backup_*/
*.tmp

# OptiScaler cached downloads
**/optiscaler/*/
!**/optiscaler/.gitkeep

# Launcher/session state
**/launcher-usage.json
**/ai-history.json
**/boot-history.json
**/notes/
**/calendar.json

# Editor/OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*~
.env

# ISO artifacts (branding + mkarchiso + AUR pkg cache). Never under a live home.
iso/out/
*.iso
