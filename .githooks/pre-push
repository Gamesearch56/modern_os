#!/usr/bin/env bash
# Installed as .git/hooks/pre-push. Runs scripts/ci-check.sh so a push
# cannot skip layer lint or shellcheck.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
# Same reason as .githooks/pre-commit: the test fixtures must not inherit
# this repository's GIT_DIR / GIT_INDEX_FILE.
exec env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
    "$ROOT/scripts/ci-check.sh"
