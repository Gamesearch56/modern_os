#!/usr/bin/env bash
# ModernOS Texteditor: one window per file, like a classic notepad.
# Each window is its own qs process, so a huge or broken file can only
# take down its own window, never the bar or the lock screen. A file
# that already has a window gets that window focused instead of a
# second copy that could overwrite it.
#
# Usage: modern-editor [FILE|file://URI]...
# MODERN_EDITOR_DRY=1 prints what would run instead of running it.
set -euo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/modern/editor.qml"
log="${XDG_STATE_HOME:-$HOME/.local/state}/modern/editor.log"

note() {
    mkdir -p "$(dirname "$log")" 2>/dev/null || return 0
    printf '%s modern-editor: %s\n' "$(date '+%F %T')" "$*" >>"$log" 2>/dev/null || true
}

local_path() {
    local raw="$1"
    case "$raw" in
        file://*)
            python3 -c 'import sys, urllib.parse; sys.stdout.write(urllib.parse.unquote(urllib.parse.urlsplit(sys.argv[1]).path))' "$raw"
            ;;
        /*) printf '%s' "$raw" ;;
        *) printf '%s/%s' "$PWD" "$raw" ;;
    esac
}

owner_pid() {
    "$dir/editor-io.sh" owner "$1" 2>/dev/null | jq -r '.pid // 0' 2>/dev/null || printf '0'
}

focus_pid() {
    local pid="$1" addr
    addr="$(hyprctl clients -j 2>/dev/null \
        | jq -r --argjson pid "$pid" 'map(select(.pid == $pid)) | .[0].address // empty' 2>/dev/null || true)"
    [ -n "$addr" ] || return 1
    hyprctl dispatch "hl.dsp.focus({ window = \"address:${addr}\" })" >/dev/null 2>&1
}

start() {
    local path="$1"
    if [ "${MODERN_EDITOR_DRY:-}" = "1" ]; then
        printf 'start %s\n' "${path:-<new>}"
        return 0
    fi
    if [ ! -f "$config" ]; then
        note "missing $config"
        exit 1
    fi
    # The Open chooser is the file manager in this process; it must not
    # save the main window's last place or focus that window.
    MODERN_FILE_WINDOW=1 MODERN_EDITOR_PATH="$path" setsid -f qs -p "$config" >/dev/null 2>&1 </dev/null
}

if [ "$#" -eq 0 ]; then
    start ""
    exit 0
fi

for raw in "$@"; do
    [ -n "$raw" ] || continue
    path="$(local_path "$raw")"
    pid="$(owner_pid "$path")"
    if [ "${pid:-0}" != "0" ]; then
        if [ "${MODERN_EDITOR_DRY:-}" = "1" ]; then
            printf 'focus %s %s\n' "$pid" "$path"
            continue
        fi
        focus_pid "$pid" && continue
        note "window $pid for $path did not take focus; opening another"
    fi
    start "$path"
done
