#!/usr/bin/env bash
# ModernOS Mediaplayer: a new window per call. Each window is its own qs
# process, so a broken file or a stuck decoder can only take down its own
# window, never the bar or the lock screen. One video opens the videos of
# its folder (one song, the songs); several files or folders open just those.
#
# Usage: modern-mediaplayer [FILE|FOLDER|file://URI]...
# MODERN_PLAYER_DRY=1 prints what would run instead of running it.
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/modern/mediaplayer.qml"
log="${XDG_STATE_HOME:-$HOME/.local/state}/modern/mediaplayer.log"

note() {
    mkdir -p "$(dirname "$log")" 2>/dev/null || return 0
    printf '%s modern-mediaplayer: %s\n' "$(date '+%F %T')" "$*" >>"$log" 2>/dev/null || true
}

# Arguments go to the window as one JSON array, so no name is ever split
# or re-parsed by a shell. URIs become paths, relative paths absolute;
# other schemes (http://, …) are dropped: the player only plays files.
args_json() {
    python3 - "$PWD" "$@" <<'PY'
import json, os, sys, urllib.parse

cwd, raw = sys.argv[1], sys.argv[2:]
out = []
for arg in raw:
    if not arg:
        continue
    if arg.startswith("file://"):
        arg = urllib.parse.unquote(urllib.parse.urlsplit(arg).path)
    elif "://" in arg:
        continue
    out.append(os.path.normpath(os.path.join(cwd, arg)))
sys.stdout.write(json.dumps(out))
PY
}

paths="$(args_json "$@")"

if [ "${MODERN_PLAYER_DRY:-}" = "1" ]; then
    printf 'start %s\n' "$paths"
    exit 0
fi
if [ ! -f "$config" ]; then
    note "missing $config"
    exit 1
fi

# The Open chooser is the file manager in this process; it must not save
# the main window's last place or focus that window.
MODERN_FILE_WINDOW=1 MODERN_PLAYER_ARGS="$paths" \
    setsid -f qs -p "$config" >/dev/null 2>&1 </dev/null
