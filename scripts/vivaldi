#!/usr/bin/env bash
# Launch Vivaldi on the profile the user named. Mail, calendar, and
# WhatsApp are --app windows of that same profile. The profile list opens
# beside a second window when the secret portal cannot unlock that
# profile's keystore, so the directory is passed explicitly.
set -euo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/modern/config.json"
VIVALDI_STATE="${XDG_CONFIG_HOME:-$HOME/.config}/vivaldi/Local State"

on=false
if [ -f "$CFG" ] && command -v jq >/dev/null 2>&1; then
    on="$(jq -r '.gaming.browserLight // false' "$CFG" 2>/dev/null || printf false)"
fi

# The directory the user renamed (is_using_default_name false). Automatic
# profiles keep Vivaldi's own name. One renamed profile is that choice.
# Several: the last one used, if it is one of them.
profile_directory() {
    local name="Default" picked=""
    if [ -f "$VIVALDI_STATE" ] && command -v jq >/dev/null 2>&1; then
        picked="$(jq -r '
            .profile as $p
            | ($p.info_cache // {}) as $c
            | [$c | to_entries[]
                | select(.value.is_using_default_name == false) | .key] as $named
            | if ($named | length) == 1 then $named[0]
              elif ($named | index($p.last_used)) != null then $p.last_used
              elif ($named | length) > 0 then $named[0]
              else ($p.last_used // "Default")
              end
        ' "$VIVALDI_STATE" 2>/dev/null || true)"
    fi
    case "$picked" in
        ""|null|..|*/|*\\*) ;;
        *) name="$picked" ;;
    esac
    if [ ! -d "${XDG_CONFIG_HOME:-$HOME/.config}/vivaldi/$name" ]; then
        name="Default"
    fi
    printf '%s\n' "$name"
}

args=(--profile-directory="$(profile_directory)")
if [ "$on" = "true" ]; then
    args+=(--in-process-gpu)
fi

if ! command -v vivaldi-stable >/dev/null 2>&1; then
    printf 'modern vivaldi: vivaldi-stable is not installed\n' >&2
    exit 127
fi
exec vivaldi-stable "${args[@]}" "$@"
