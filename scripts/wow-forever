#!/usr/bin/env bash
# Launch only WoW Forever inside gamescope with HDR. Battle.net stays on
# XWayland. The game stays an X11 client of gamescope; gamescope is the
# Wayland window Hyprland shows on the HDR display. HDR frames never
# reach the desktop except through that window.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# gamescope runs this script again as its child. That child must not see
# the host Wayland socket: Battle.net's agent copies the environment it
# was started with, and a game it then starts lands on the host display.
INSIDE=0
if [ "${1:-}" = "--inside" ]; then
    INSIDE=1
    shift
fi
# shellcheck source=../install/lib/i18n.sh
source "$REPO_ROOT/install/lib/i18n.sh"
# shellcheck source=../install/lib/ge-proton.sh
source "$REPO_ROOT/install/lib/ge-proton.sh"
# shellcheck source=lib/wow-hdr.sh
source "$SCRIPT_DIR/lib/wow-hdr.sh"
# shellcheck source=lib/wow-clipboard.sh
source "$SCRIPT_DIR/lib/wow-clipboard.sh"

MODERN_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/modern"
ENV_FILE="${MODERN_DIR}/battlenet.env"
CFG="${MODERN_DIR}/config.json"
if [ -f "$CFG" ] && command -v jq >/dev/null 2>&1; then
    I18N_LANG="$(jq -r '.language.ui // "en"' "$CFG" 2>/dev/null || printf 'en')"
    [ "$I18N_LANG" = "de" ] || I18N_LANG="en"
fi

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/modern"
LOG="$LOG_DIR/wow-forever.log"
EXE_REL="drive_c/Program Files (x86)/World of Warcraft/_forever_/Wow.exe"
QUICK_EXIT_SECONDS="${WOW_QUICK_EXIT:-30}"

STEAM_ROOT="${STEAM_ROOT:-$HOME/.local/share/Steam}"
if [ ! -d "$STEAM_ROOT/steamapps" ] && [ -d "$HOME/.steam/steam/steamapps" ]; then
    STEAM_ROOT="$HOME/.steam/steam"
fi

export WINE_SIMULATE_WRITECOPY="${WINE_SIMULATE_WRITECOPY:-1}"
export AMD_VULKAN_ICD="${AMD_VULKAN_ICD:-RADV}"

if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck source=/dev/null
    source "$ENV_FILE"
    set +a
fi

# gamescope owns the Wayland HDR surface. A Wayland Proton client would
# skip gamescope's X11 display and the HDR layer would never see the frame.
export PROTON_ENABLE_WAYLAND=0
export DXVK_HDR=1
export ENABLE_HDR_WSI=1
export PROTON_ENABLE_HDR=1

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a modern "$(t wow.title)" "$1" || true
}

fail() {
    printf 'wow-forever: %s\n' "$1" >&2
    notify "$1"
    exit 1
}

use_prefix_of() {
    local exe="$1" prefix
    prefix="${exe%%/drive_c/*}"
    [ "$prefix" != "$exe" ] || return 0
    export WINEPREFIX="$prefix"
    if [ -z "${STEAM_COMPAT_DATA_PATH:-}" ] && [ "$(basename "$WINEPREFIX")" = "pfx" ]; then
        export STEAM_COMPAT_DATA_PATH="${WINEPREFIX%/pfx}"
    fi
}

find_wow() {
    local candidate prefix
    if [ -n "${WOW_EXE:-}" ] && [ -f "$WOW_EXE" ]; then
        printf '%s\n' "$WOW_EXE"
        return 0
    fi
    local -a prefixes=()
    prefixes+=("${XDG_DATA_HOME:-$HOME/.local/share}/modern/battlenet/pfx")
    prefixes+=("$HOME/Games/battlenet")
    if [ -d "$STEAM_ROOT/steamapps/compatdata" ]; then
        for prefix in "$STEAM_ROOT"/steamapps/compatdata/*/pfx; do
            [ -d "$prefix" ] && prefixes+=("$prefix")
        done
    fi
    for prefix in "${prefixes[@]}"; do
        candidate="$prefix/$EXE_REL"
        if [ -f "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

find_proton() {
    local candidate
    if [ -n "${PROTONPATH:-}" ] && [ -x "${PROTONPATH}/proton" ]; then
        printf '%s\n' "$PROTONPATH"
        return 0
    fi
    candidate="$(ge_proton_dir "$HOME")"
    if [ -x "$candidate/proton" ]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    for candidate in \
        "$STEAM_ROOT/steamapps/common/Proton - Experimental" \
        "$STEAM_ROOT/steamapps/common/Proton Hotfix" \
        "$HOME/.steam/root/compatibilitytools.d"/GE-Proton*; do
        if [ -x "$candidate/proton" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

# Peak from the primary display profile, when it has one.
wow_hdr_peak() {
    [ -f "$CFG" ] && command -v jq >/dev/null 2>&1 || return 0
    local desc peak
    desc="$(jq -r '.monitors.primaryDescription // empty' "$CFG" 2>/dev/null || true)"
    [ -n "$desc" ] || return 0
    peak="$(jq -r --arg d "$desc" '.monitors.profiles[$d].max_luminance // empty' "$CFG" 2>/dev/null || true)"
    case "$peak" in
        ''|*[!0-9]*) return 0 ;;
        *) printf '%s\n' "$peak" ;;
    esac
}

# Gamescope's X server does not inherit the compositor keymap. Without
# this it starts on the us layout, so a German desktop types English
# inside the game window.
apply_keyboard() {
    [ -f "$CFG" ] && command -v jq >/dev/null 2>&1 || return 0
    local layout variant
    layout="$(jq -r '.input.kbLayout // empty' "$CFG" 2>/dev/null || true)"
    variant="$(jq -r '.input.kbVariant // empty' "$CFG" 2>/dev/null || true)"
    [ -n "$layout" ] || return 0
    export XKB_DEFAULT_LAYOUT="$layout"
    if [ -n "$variant" ]; then
        export XKB_DEFAULT_VARIANT="$variant"
    else
        unset XKB_DEFAULT_VARIANT
    fi
}

# Primary display mode, e.g. 2560x1440@143.91. Empty when unset.
primary_mode() {
    [ -f "$CFG" ] && command -v jq >/dev/null 2>&1 || return 0
    local desc
    desc="$(jq -r '.monitors.primaryDescription // empty' "$CFG" 2>/dev/null || true)"
    [ -n "$desc" ] || return 0
    jq -r --arg d "$desc" '.monitors.profiles[$d].mode // empty' "$CFG" 2>/dev/null || true
}

primary_sdr_nits() {
    [ -f "$CFG" ] && command -v jq >/dev/null 2>&1 || return 0
    local desc nits
    desc="$(jq -r '.monitors.primaryDescription // empty' "$CFG" 2>/dev/null || true)"
    [ -n "$desc" ] || return 0
    nits="$(jq -r --arg d "$desc" '.monitors.profiles[$d].sdr_max_luminance // empty' "$CFG" 2>/dev/null || true)"
    case "$nits" in
        ''|*[!0-9]*) return 0 ;;
        *) printf '%s\n' "$nits" ;;
    esac
}

exe="$(find_wow)" || fail "$(t wow.missing)"
use_prefix_of "$exe"
export GAMEID="${GAMEID:-umu-wow-forever}"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$STEAM_ROOT}"
if [ -n "${STEAM_COMPAT_DATA_PATH:-}" ]; then
    id="$(basename "$STEAM_COMPAT_DATA_PATH")"
    if [[ "$id" =~ ^[0-9]+$ ]]; then
        export SteamAppId="${SteamAppId:-$id}" SteamGameId="${SteamGameId:-$id}"
        export STEAM_COMPAT_APP_ID="${STEAM_COMPAT_APP_ID:-$id}"
    fi
fi

runner=()
if command -v umu-run >/dev/null 2>&1; then
    if proton="$(find_proton)"; then
        export PROTONPATH="$proton"
    fi
    runner=(umu-run "$exe")
elif proton="$(find_proton)"; then
    export PROTONPATH="$proton"
    runner=("$proton/proton" waitforexitandrun "$exe")
else
    fail "$(t wow.noRunner)"
fi

# The agent on the host display starts its own Wow.exe. That window is
# ordinary XWayland, so the HDR container never sees the frame.
if [ "$INSIDE" = 1 ]; then
    host_wl="${WOW_HOST_WAYLAND:-}"
    export PROTON_ENABLE_WAYLAND=0
    if [ -n "$host_wl" ] && [ -n "${DISPLAY:-}" ]; then
        wow_clipboard_start "$host_wl" "$DISPLAY" || true
    fi
    unset WAYLAND_DISPLAY
    wow_hdr_hold_on "$(wow_hdr_peak || true)"
    set +e
    "${runner[@]}"
    status=$?
    set -e
    wow_clipboard_stop || true
    # The game has saved its settings. Put the desktop copy back to SDR
    # before Battle.net's Play button can start it.
    wow_hdr_apply off || true
    flock -u 9 2>/dev/null || true
    exit "$status"
fi

command -v gamescope >/dev/null 2>&1 || fail "$(t wow.noGamescope)"

width="" height="" rate=""
mode="$(primary_mode)"
if [[ "$mode" =~ ^([0-9]+)x([0-9]+)@([0-9]+)(\.([0-9]+))? ]]; then
    width="${BASH_REMATCH[1]}"
    height="${BASH_REMATCH[2]}"
    rate="${BASH_REMATCH[3]}"
    # 143.91 is the panel's 144 Hz mode. gamescope wants a whole number.
    if [ -n "${BASH_REMATCH[5]}" ] && [ "${BASH_REMATCH[5]:0:1}" -ge 5 ]; then
        rate=$((rate + 1))
    fi
fi

# Hyprland does not advertise HDR on the Wayland surface gamescope nests
# in, so gamescope would tonemap the game down to an SDR picture.
# --hdr-debug-force-output makes it send HDR10 anyway. The primary
# display profile is already HDR; this only affects this window.
args=(gamescope --backend wayland --hdr-enabled --hdr-debug-force-output --force-windows-fullscreen -f)
[ -n "$width" ] && args+=(-w "$width" -h "$height" -W "$width" -H "$height")
[ -n "$rate" ] && args+=(-r "$rate")
nits="$(primary_sdr_nits || true)"
[ -n "$nits" ] && args+=(--hdr-sdr-content-nits "$nits")
args+=(--)
args+=("$0" --inside)

if command -v gamemoderun >/dev/null 2>&1; then
    args=(gamemoderun "${args[@]}")
fi

# The nested size comes from the primary display profile. Open there too,
# so the HDR window is not created on a second SDR panel.
focus_primary() {
    command -v hyprctl >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0
    [ -f "$CFG" ] || return 0
    local desc name
    desc="$(jq -r '.monitors.primaryDescription // empty' "$CFG" 2>/dev/null || true)"
    [ -n "$desc" ] || return 0
    name="$(hyprctl monitors -j 2>/dev/null | jq -r --arg d "$desc" '.[] | select(.description == $d) | .name' | head -n 1)"
    [ -n "$name" ] || return 0
    hyprctl dispatch focusmonitor "$name" >/dev/null 2>&1 || true
}

apply_keyboard

if [ "${WOW_DRY_RUN:-0}" = "1" ]; then
    printf 'PROTON_ENABLE_WAYLAND=%s\n' "$PROTON_ENABLE_WAYLAND"
    printf 'DXVK_HDR=%s\n' "$DXVK_HDR"
    printf 'ENABLE_HDR_WSI=%s\n' "$ENABLE_HDR_WSI"
    printf 'PROTON_ENABLE_HDR=%s\n' "$PROTON_ENABLE_HDR"
    printf 'STEAM_COMPAT_CLIENT_INSTALL_PATH=%s\n' "$STEAM_COMPAT_CLIENT_INSTALL_PATH"
    if [ -n "${XKB_DEFAULT_LAYOUT:-}" ]; then
        printf 'XKB_DEFAULT_LAYOUT=%s\n' "$XKB_DEFAULT_LAYOUT"
    fi
    if [ -n "${XKB_DEFAULT_VARIANT:-}" ]; then
        printf 'XKB_DEFAULT_VARIANT=%s\n' "$XKB_DEFAULT_VARIANT"
    fi
    printf '%q ' "${runner[@]}"
    printf '\n'
    printf '%q ' "${args[@]}"
    printf '\n'
    exit 0
fi

mkdir -p "$LOG_DIR"
{
    printf '\n--- %s ---\n' "$(date -Iseconds)"
    printf '%q ' "${args[@]}"
    printf '\n'
} >>"$LOG"

# comm is the wine process, not a shell whose command line merely
# mentions the exe. Killing the latter would stop this launcher.
pids_named() {
    local name="$1" dir pid comm
    for dir in /proc/[0-9]*; do
        pid="${dir#/proc/}"
        [ -r "$dir/comm" ] || continue
        comm="$(cat "$dir/comm" 2>/dev/null || true)"
        [ "$comm" = "$name" ] && printf '%s\n' "$pid"
    done
}

display_of() {
    [ -r "/proc/$1/environ" ] || return 0
    tr '\0' '\n' <"/proc/$1/environ" | awk -F= '/^DISPLAY=/{print $2; exit}'
}

# Drop a process the agent opened on the host display. The HDR window
# is a different process, started below. The agent is included: it
# otherwise starts a second Wow.exe outside this container.
reap_host_named() {
    local name="$1" host="$2" pid disp
    [ -n "$host" ] || return 0
    while read -r pid; do
        [ -n "$pid" ] || continue
        disp="$(display_of "$pid")"
        if [ "$disp" = "$host" ]; then
            kill "$pid" 2>/dev/null || true
        fi
    done < <(pids_named "$name")
}

# gamescope -f is lost when the window is retitled, and that drop looks
# like SUPER+F to the fullscreen helper, which then leaves the game
# tiled. Cover the Wayland window once it exists.
cover_gamescope() {
    local addr
    for _ in $(seq 1 60); do
        addr="$(hyprctl clients -j 2>/dev/null | jq -r '
            .[] | select(.xwayland == false)
            | select(.class == "gamescope" or .title == "World of Warcraft")
            | .address' | head -n 1)"
        if [ -n "$addr" ] && [ "$addr" != "null" ]; then
            hyprctl dispatch focuswindow "address:${addr}" >/dev/null 2>&1 || true
            hyprctl dispatch fullscreenstate 2 2 >/dev/null 2>&1 || true
            return 0
        fi
        sleep 0.5
    done
}

stop_previous() {
    local pid
    while read -r pid; do
        [ -n "$pid" ] || continue
        [ "$pid" = "$$" ] && continue
        [ "$pid" = "${PPID:-}" ] && continue
        kill "$pid" 2>/dev/null || true
    done < <(pgrep -f 'scripts/wow-forever' || true)
}

HOST_DISPLAY="${DISPLAY:-}"
export WOW_HOST_DISPLAY="$HOST_DISPLAY"
export WOW_HOST_WAYLAND="${WAYLAND_DISPLAY:-}"
stop_previous
reap_host_named "Wow.exe" "$HOST_DISPLAY"
reap_host_named "Agent.exe" "$HOST_DISPLAY"
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    (
        for _ in $(seq 1 45); do
            reap_host_named "Wow.exe" "$HOST_DISPLAY"
            reap_host_named "Agent.exe" "$HOST_DISPLAY"
            sleep 1
        done
    ) &
    helper=$!
    cover_gamescope &
    cover=$!
    trap 'kill "$helper" "$cover" 2>/dev/null || true' EXIT
fi

focus_primary
started=$SECONDS
set +e
"${args[@]}" >>"$LOG" 2>&1
status=$?
set -e
if [ $((SECONDS - started)) -lt "$QUICK_EXIT_SECONDS" ]; then
    notify "$(t wow.crashed "$LOG")"
    exit 1
fi
exit "$status"
