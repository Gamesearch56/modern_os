#!/usr/bin/env bash
# Drive the running Quickshell session from scripts and Hyprland
# keybinds. Thin wrapper over `qs ipc` so muscle-memory `modern launcher
# toggle` stays stable if the IPC target names ever move.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: modern <target> <function> [args...]

Examples:
  modern launcher toggle
  modern powermenu toggle
  modern cheatsheet toggle
  modern settings open
  modern volume up
  modern shell reload
  modern config set motion.scale 1.2
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ $# -lt 1 ]; then
    usage
    exit 0
fi

TARGET="$1"
shift

ipc() {
    exec qs -c modern ipc call "$@"
}

case "$TARGET" in
    volume)
        ACTION="${1:-up}"
        case "$ACTION" in
            up) ipc audio volumeUp ;;
            down) ipc audio volumeDown ;;
            mute) ipc audio mute ;;
            *) echo "unknown volume action: $ACTION" >&2; exit 1 ;;
        esac
        ;;
    lang)
        echo "language switching is Settings > Language (or edit config.json language.ui)" >&2
        exit 1
        ;;
    wallpaper)
        ipc wallpaper "${1:-pick}"
        ;;
    shell)
        ipc shell "${1:-reload}"
        ;;
    settings)
        ipc settings "${1:-open}"
        ;;
    config)
        SUB="${1:-}"
        shift || true
        case "$SUB" in
            set)
                SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
                exec "$SCRIPT_DIR/config-set.sh" "$@"
                ;;
            *)
                echo "Usage: modern config set PATH VALUE" >&2
                exit 1
                ;;
        esac
        ;;
    game)
        shift || true
        exec modern-game "$@"
        ;;
    screenshot)
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        exec "$SCRIPT_DIR/screenshot.sh" "${1:-region}"
        ;;
    *)
        FUNC="${1:-toggle}"
        ipc "$TARGET" "$FUNC"
        ;;
esac
